{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_service%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "reconfigure_successful": "Re-configuration was successful"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "step": {
      "reauth_confirm": {
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]"
        },
        "data_description": {
          "api_key": "[%key:component::perplexity::config::step::user::data_description::api_key%]"
        },
        "description": "[%key:component::perplexity::config::step::user::description%]"
      },
      "reconfigure": {
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]"
        },
        "data_description": {
          "api_key": "[%key:component::perplexity::config::step::user::data_description::api_key%]"
        },
        "description": "[%key:component::perplexity::config::step::user::description%]"
      },
      "user": {
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]"
        },
        "data_description": {
          "api_key": "Perplexity API key"
        },
        "description": "Provide your Perplexity API key.\nTo generate an API key go to {api_key_url}"
      }
    }
  },
  "config_subentries": {
    "ai_task_data": {
      "entry_type": "AI task",
      "initiate_flow": {
        "user": "Add AI task"
      },
      "step": {
        "reconfigure": {
          "data": {
            "reasoning_effort": "Reasoning effort",
            "web_search": "Web search"
          },
          "data_description": {
            "reasoning_effort": "Controls how much effort the model spends on reasoning",
            "web_search": "Enable web search to get up-to-date information from the internet"
          },
          "description": "Configure the AI task options"
        },
        "user": {
          "data": {
            "model": "Model"
          },
          "data_description": {
            "model": "The model to use for the AI task"
          },
          "description": "Configure the new AI task"
        }
      }
    }
  },
  "exceptions": {
    "api_error": {
      "message": "Error talking to Perplexity API for {entry}: {error}"
    },
    "auth_error": {
      "message": "Authentication failed for {entry}, please update your API key"
    },
    "file_not_found": {
      "message": "`{file_path}` does not exist"
    },
    "no_assistant_response": {
      "message": "Last content in chat log is not an AssistantContent"
    },
    "structured_response_error": {
      "message": "Error with Perplexity structured response: {error}"
    },
    "unsupported_file_type": {
      "message": "Only images are supported by the Perplexity API, `{file_path}` is not an image file"
    }
  },
  "selector": {
    "reasoning_effort": {
      "options": {
        "high": "High",
        "low": "Low",
        "medium": "Medium",
        "minimal": "Minimal"
      }
    }
  }
}
